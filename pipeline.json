{
  "tools": {
    "node": "22"
  },
  "setup": [
    "npm ci"
  ],
  "checks": [
    {
      "name": "型チェック",
      "run": "npm run typecheck"
    },
    {
      "name": "リント",
      "run": "npm run lint"
    },
    {
      "name": "テスト",
      "run": "npm run test"
    },
    {
      "name": "ビルド",
      "run": "npm run build"
    }
  ],
  "deploy": [
    {
      "kind": "github-pages",
      "build": "PAGES_BASE_PATH=/neon-sneaker-drop npm run build"
    }
  ]
}
